node_modules/
.env

# Compiled output (built on publish via `bun run build` / prepublishOnly).
/dist/

# Per-user agent skill copies generated by `install-skill` (the canonical skill is .claude/skills/yt).
/.cursor/
/.agents/

# User briefing state (default location in a dev clone). Yours to keep private or version yourself.
/data/
# When consumed as a dependency, state lives in <your project>/.yt-briefing/ instead.
/.yt-briefing/
# If YT_DATA_DIR points elsewhere, that's your call to ignore/commit.

# Throwaway session cache, wherever the data dir lives.
.cache/
