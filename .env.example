# yt-briefing secrets. Copy to .env (the onboarding wizard writes this for you):
#   bun run init
# .env is gitignored — never commit real keys.

# --- LLM (any OpenAI-compatible endpoint) ---
# One model does everything (title filtering + summaries). Default: Gemini 2.5 Flash
# via OpenRouter ("any model, one key"). See README → Providers for the OpenAI-direct
# and Gemini-direct variants (just change these three lines).
YT_BRIEFING_LLM_BASE_URL=https://openrouter.ai/api/v1
YT_BRIEFING_LLM_API_KEY=
YT_BRIEFING_LLM_MODEL=google/gemini-2.5-flash

# --- YouTube Data API v3 (lists channel uploads) ---
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YT_BRIEFING_YOUTUBE_API_KEY=

# --- Transcript proxy (optional) ---
# Only needed on datacenter/VPS IPs, which YouTube blocks. Blank = direct fetch
# (works on residential IPs / locally). See docs/warp-proxy.md.
YT_BRIEFING_PROXY=

# --- yt-dlp location (optional) ---
# Set only if yt-dlp isn't on your PATH (point it straight at the binary).
# YT_BRIEFING_DLP_PATH=/opt/tools/yt-dlp
