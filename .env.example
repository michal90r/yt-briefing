# yt-briefing config — your project's ROOT .env. Set these here, or export them (an exported var
# wins). Only the YouTube key is REQUIRED: miss it and the engine fails fast naming it. Filtering
# and summaries run on your Claude Code login (`claude -p`) — there is no LLM key.
# .env is gitignored — never commit real keys.

# --- YouTube Data API v3 (lists channel uploads) --- REQUIRED
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YT_BRIEFING_YOUTUBE_API_KEY=

# --- Transcript proxy (optional) ---
# Only needed on datacenter/VPS IPs, which YouTube blocks. Blank = direct fetch
# (works on residential IPs / locally). See docs/warp-proxy.md.
YT_BRIEFING_PROXY=

# --- Claude model (optional) ---
# Model for filtering + summaries, as `claude --model` takes it (alias or full name). Default: haiku.
# YT_BRIEFING_MODEL=sonnet

# --- yt-dlp location (optional) ---
# Set only if yt-dlp isn't on your PATH (point it straight at the binary).
# YT_BRIEFING_DLP_PATH=/opt/tools/yt-dlp
