# yt-briefing config — your project's ROOT .env. Set these here, or export them (an exported var
# wins). Every variable below except PROXY / DLP_PATH is REQUIRED: miss one and the engine fails
# fast naming exactly which. .env is gitignored — never commit real keys.

# --- LLM (any OpenAI-compatible endpoint) --- REQUIRED (all three, no defaults)
# One model does everything (title filtering + summaries). Below: Gemini 2.5 Flash direct,
# which has a free AI Studio key. See README → Providers for the OpenRouter / OpenAI / Ollama
# variants (just change these three lines).
YT_BRIEFING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
YT_BRIEFING_LLM_API_KEY=
YT_BRIEFING_LLM_MODEL=gemini-2.5-flash

# --- YouTube Data API v3 (lists channel uploads) --- REQUIRED
# https://console.cloud.google.com → enable "YouTube Data API v3" → create an API key.
YT_BRIEFING_YOUTUBE_API_KEY=

# --- Transcript proxy (optional) ---
# Only needed on datacenter/VPS IPs, which YouTube blocks. Blank = direct fetch
# (works on residential IPs / locally). See docs/warp-proxy.md.
YT_BRIEFING_PROXY=

# --- yt-dlp location (optional) ---
# Set only if yt-dlp isn't on your PATH (point it straight at the binary).
# YT_BRIEFING_DLP_PATH=/opt/tools/yt-dlp
